# Single governed source manifest. Every production and third-party dependency
# is exact-SHA locked; no production restore follows a mutable branch.
# Project tooling consumes the profile markers below and never selects
# quarantine. Use Scripts/installation/uav_px4_dds_install.sh rather than a
# generic vcs import: the quarantined serial_driver_ros checkout is nested in
# the active communication repository and pinned there as a Git submodule.
repositories:
# profile: active
  src/px4_msgs:
    type: git
    url: https://github.com/PX4/px4_msgs.git
    version: 392e831c1f659429ca83902e66820d7094591410
  src/Micro-XRCE-DDS-Agent:
    type: git
    url: https://github.com/eProsima/Micro-XRCE-DDS-Agent.git
    version: 57d086216d01ec43121845d385894a25987f8a2c
  src/offboard_cpp:
    type: git
    url: https://github.com/BoomBoomFly/offboard_cpp.git
    version: 26fa6ff567f8da76e3ca53c787859755975dc285
  src/vision_to_dds:
    type: git
    url: https://github.com/BoomBoomFly/vision_to_dds.git
    version: 0815c85b047d27b158d3869ab6ecf3926f28e6fe
  src/communication:
    type: git
    url: https://github.com/BoomBoomFly/communication.git
    version: 375b7811660e09411d7a3c984c396f45f5881eb8

# profile: archive
  src/px4_bringup:
    type: git
    url: https://github.com/BoomBoomFly/px4_bringup.git
    version: DDS

# profile: optional-perception
  src/librealsense:
    type: git
    url: https://github.com/IntelRealSense/librealsense.git
    version: c94410a420b74e5fb6a414bd12215c05ddd82b69
  src/realsense-ros:
    type: git
    url: https://github.com/IntelRealSense/realsense-ros.git
    version: 8abb4657c0add15f87b0edbfb67eaba2c1c2c439
  src/vision_opencv:
    type: git
    url: https://github.com/ros-perception/vision_opencv.git
    version: 72152d9d1d8edcfcafd707a1d0103810db8613ba

# profile: optional-navigation
  src/gazebo_ros_pkgs:
    type: git
    url: https://github.com/ros-simulation/gazebo_ros_pkgs.git
    version: b6f7bf121d0c607825b65a28b227a5459a71821b
  src/imu_tools:
    type: git
    url: https://github.com/ccny-ros-pkg/imu_tools.git
    version: d28555e487e4c1278c9a2e94143dc79dcc8941bf
  src/navigation2:
    type: git
    url: https://github.com/ros-navigation/navigation2.git
    version: ca482808a7a7c52ce01ae3c662dc2b980968fc16
  src/navigation_msgs:
    type: git
    url: https://github.com/ros-planning/navigation_msgs.git
    version: fe880e99d993e9d4dfbf37f00d839d32994610e1
  src/rplidar_ros:
    type: git
    url: https://github.com/Slamtec/rplidar_ros.git
    version: 24cc9b6dea97e045bda1408eaa867ce730fd3fc3
  src/rtabmap:
    type: git
    url: https://github.com/introlab/rtabmap.git
    version: 0070de4aafab0feaf5e37b497b1354d2264d41c8
  src/rtabmap_ros:
    type: git
    url: https://github.com/introlab/rtabmap_ros.git
    version: b341e2a776a743b8d6741b8aae8ab560471cd966
  src/slam_toolbox:
