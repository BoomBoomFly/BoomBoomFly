{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "production_enabled",
    "production_allowlist",
    "historical_denied_inventory",
    "forbidden_package_patterns",
    "forbidden_executable_patterns",
    "device_patterns",
    "agent_patterns",
    "forbidden_topic_patterns",
    "writer_inventory"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "production_enabled": {"const": false},
    "production_allowlist": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodes", "note"],
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["package", "executable", "name"],
              "properties": {
                "package": {"type": "string"},
                "executable": {"type": "string"},
                "name": {"type": "string"}
              }
            }
          },
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "historical_denied_inventory": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativePath"}
    },
    "forbidden_package_patterns": {"$ref": "#/$defs/patterns"},
    "forbidden_executable_patterns": {"$ref": "#/$defs/patterns"},
    "device_patterns": {"$ref": "#/$defs/patterns"},
    "agent_patterns": {"$ref": "#/$defs/patterns"},
    "forbidden_topic_patterns": {"$ref": "#/$defs/patterns"},
    "writer_inventory": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^/fmu/in/"}
      }
    }
  },
  "$defs": {
    "patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {"pattern": "^/"},
          {"pattern": "(^|/)\\.\\.(/|$)"}
        ]
      }
    }
  }
}
