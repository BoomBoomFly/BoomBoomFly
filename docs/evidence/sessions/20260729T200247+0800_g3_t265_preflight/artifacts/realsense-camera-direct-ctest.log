-                imu_msgs.push_back(CreateUnitedMessage(crnt_accel, crnt_gyro));
-            }
-            accel0 = accel1;
-        }
-        else if (accel0.is_set() && crnt_imu.m_time_ns >= accel0.m_time_ns && crnt_imu.m_type == GYRO)
