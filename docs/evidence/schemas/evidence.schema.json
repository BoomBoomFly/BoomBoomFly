{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/BoomBoomFly/BoomBoomFly/docs/evidence/schemas/evidence.schema.json",
  "title": "BoomBoomFly evidence metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "title",
    "evidence_type",
    "status",
    "created_at",
    "supersedes",
    "superseded_by",
    "repository",
    "dependency_shas",
    "dirty_receipt_ids",
    "environment_id",
    "command",
    "start_time",
    "end_time",
    "exit_code",
    "stdout_artifact",
    "stderr_artifact",
    "test_result",
    "artifacts",
    "hardware_access",
    "px4_parameter_access",
    "firmware_access",
    "limitations",
    "reviewer"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^BBF-EVID-[A-Z0-9][A-Z0-9._-]{2,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidence_type": {
      "enum": [
        "build",
        "test",
        "environment",
        "workspace_receipt",
        "parameter_snapshot",
        "firmware",
        "configuration",
        "release",
        "rollback",
        "other"
      ]
    },
    "status": {
      "enum": [
        "current",
        "historical",
        "superseded",
        "unverified",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^BBF-EVID-[A-Z0-9][A-Z0-9._-]{2,127}$"
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^BBF-EVID-[A-Z0-9][A-Z0-9._-]{2,127}$"
    },
    "repository": {
      "$ref": "#/definitions/repository"
    },
    "dependency_shas": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/dependency"
      }
    },
    "dirty_receipt_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "command": {
      "$ref": "#/definitions/command"
    },
    "start_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "end_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "stdout_artifact": {
      "oneOf": [
        {
          "$ref": "#/definitions/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "stderr_artifact": {
      "oneOf": [
        {
          "$ref": "#/definitions/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "test_result": {
      "$ref": "#/definitions/test_result"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/artifact"
      }
    },
    "hardware_access": {
      "enum": [
        "none",
        "read_only",
        "write"
      ]
    },
    "px4_parameter_access": {
      "enum": [
        "none",
        "read_only",
        "write"
      ]
    },
    "firmware_access": {
      "enum": [
        "none",
        "build_only",
        "flash"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer": {
      "$ref": "#/definitions/reviewer"
    }
  },
  "definitions": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "root_branch",
        "root_head"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "root_branch": {
          "type": "string",
          "minLength": 1
        },
        "root_head": {
          "$ref": "#/definitions/sha1"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "$ref": "#/definitions/sha1"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "test_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "summary"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "unverified",
            "not_applicable"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "identity",
        "reviewed_at"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "identity": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "current"
          }
        }
      },
      "then": {
        "properties": {
          "superseded_by": {
            "type": "null"
          },
          "exit_code": {
            "type": "integer"
          },
          "stdout_artifact": {
            "$ref": "#/definitions/artifact"
          },
          "stderr_artifact": {
            "$ref": "#/definitions/artifact"
          },
          "test_result": {
            "properties": {
              "outcome": {
                "enum": [
                  "passed",
                  "not_applicable"
                ]
              }
            }
          },
          "reviewer": {
            "properties": {
              "state": {
                "const": "approved"
              },
              "identity": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        }
      },
      "then": {
        "properties": {
          "superseded_by": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unverified"
          }
        }
      },
      "then": {
        "properties": {
          "test_result": {
            "properties": {
              "outcome": {
                "enum": [
                  "blocked",
                  "unverified",
                  "not_applicable"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "test_result": {
            "properties": {
              "outcome": {
                "enum": [
                  "failed",
                  "blocked"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
