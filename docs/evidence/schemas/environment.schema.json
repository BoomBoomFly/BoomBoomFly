{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/BoomBoomFly/BoomBoomFly/docs/evidence/schemas/environment.schema.json",
  "title": "BoomBoomFly environment inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment_id",
    "captured_at",
    "repository",
    "platform",
    "ros",
    "tools",
    "px4_source",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "environment_id": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "branch",
        "head"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "kernel",
        "architecture"
      ],
      "properties": {
        "os": {
          "$ref": "#/definitions/probe"
        },
        "kernel": {
          "$ref": "#/definitions/probe"
        },
        "architecture": {
          "$ref": "#/definitions/probe"
        }
      }
    },
    "ros": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "packages"
      ],
      "properties": {
        "distribution": {
          "$ref": "#/definitions/probe"
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/probe"
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/probe"
      }
    },
    "px4_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managed_workspace",
        "host_search_status",
        "host_search_reason",
        "submodules"
      ],
      "properties": {
        "managed_workspace": {
          "$ref": "#/definitions/probe"
        },
        "host_search_status": {
          "enum": [
            "present",
            "missing",
            "unverified"
          ]
        },
        "host_search_reason": {
          "type": "string"
        },
        "submodules": {
          "$ref": "#/definitions/probe"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "requirement",
        "required_for",
        "status",
        "version",
        "command",
        "exit_code",
        "stdout",
        "stderr",
        "reason"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "requirement": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "required_for": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "present",
            "missing",
            "unverified"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "not": {
            "const": "latest"
          }
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "exit_code": {
          "type": "integer"
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
