{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/BoomBoomFly/BoomBoomFly/docs/evidence/schemas/evidence_index.schema.json",
  "title": "BoomBoomFly evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "repository",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "root_branch",
        "root_head"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "root_branch": {
          "type": "string",
          "minLength": 1
        },
        "root_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/entry"
      }
    }
  },
  "definitions": {
    "evidence_id": {
      "type": "string",
      "pattern": "^BBF-EVID-[A-Z0-9][A-Z0-9._-]{2,127}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "title",
        "evidence_type",
        "status",
        "path",
        "sha256",
        "metadata_path",
        "known_historical",
        "supersedes",
        "superseded_by",
        "limitations"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/definitions/evidence_id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "evidence_type": {
          "enum": [
            "validation_record",
            "parameter_snapshot",
            "build",
            "test",
            "environment",
            "workspace_receipt",
            "firmware",
            "configuration",
            "release",
            "rollback",
            "other"
          ]
        },
        "status": {
          "enum": [
            "current",
            "historical",
            "superseded",
            "unverified",
            "failed"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "metadata_path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "known_historical": {
          "type": "boolean"
        },
        "supersedes": {
          "oneOf": [
            {
              "$ref": "#/definitions/evidence_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "superseded_by": {
          "oneOf": [
            {
              "$ref": "#/definitions/evidence_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
