{
  "$id": "https://boomboomfly.example/schemas/sitl/event-1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One offline JSONL timeline event. This schema does not imply a live ROS observation.",
  "properties": {
    "correlation_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_type": {
      "minLength": 1,
      "type": "string"
    },
    "message_type": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "monotonic_timestamp": {
      "minimum": 0,
      "type": "number"
    },
    "result": {
      "enum": [
        "OBSERVED",
        "ACCEPTED",
        "REJECTED",
        "TIMEOUT",
        "ERROR",
        "CLEANED"
      ],
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^SITL-(NORMAL|FAULT)-[0-9]{3}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "type": "string"
    },
    "state_after": {
      "type": "string"
    },
    "state_before": {
      "type": "string"
    },
    "target": {
      "minLength": 1,
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "topic": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "timestamp",
    "monotonic_timestamp",
    "scenario_id",
    "event_type",
    "source",
    "target",
    "topic",
    "message_type",
    "correlation_id",
    "state_before",
    "state_after",
    "result",
    "metadata"
  ],
  "title": "BoomBoomFly SITL timeline event",
  "type": "object"
}
