{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BoomBoomFly/BoomBoomFly/docs/authority/schemas/authority-envelope.schema.json",
  "title": "BoomBoomFly authority command envelope",
  "description": "Atomic mission-owner command envelope. Schema validation alone does not authorize PX4 publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "owner",
    "lease",
    "sequence",
    "created_monotonic_ns",
    "deadline_monotonic_ns",
    "source_epoch",
    "graph_epoch",
    "command"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "envelope_id": {
      "$ref": "#/$defs/opaqueId"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "instance_id"
      ],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "instance_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lease_id",
        "lifecycle",
        "issued_monotonic_ns",
        "expires_monotonic_ns"
      ],
      "properties": {
        "lease_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "lifecycle": {
          "enum": [
            "GRANTED",
            "ACTIVE",
            "RENEWING",
            "RELINQUISHING",
            "REVOKED",
            "EXPIRED"
          ]
        },
        "issued_monotonic_ns": {
          "$ref": "#/$defs/monotonicNs"
        },
        "expires_monotonic_ns": {
          "$ref": "#/$defs/positiveMonotonicNs"
        }
      }
    },
    "sequence": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "created_monotonic_ns": {
      "$ref": "#/$defs/monotonicNs"
    },
    "deadline_monotonic_ns": {
      "$ref": "#/$defs/positiveMonotonicNs"
    },
    "source_epoch": {
      "$ref": "#/$defs/epochId"
    },
    "graph_epoch": {
      "$ref": "#/$defs/epochId"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlation_id",
        "kind",
        "payload"
      ],
      "properties": {
        "correlation_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "kind": {
          "enum": [
            "CONTROL_TRANSACTION",
            "HOLD",
            "LAND",
            "RELEASE"
          ]
        },
        "payload": {
          "type": "object",
          "description": "Atomic kind-specific payload. Its production message definition is deferred to the single integration owner.",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      }
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "epochId": {
      "type": "string",
      "minLength": 7,
      "maxLength": 128,
      "pattern": "^epoch:[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "monotonicNs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveMonotonicNs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 1024
        },
        {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    }
  }
}
