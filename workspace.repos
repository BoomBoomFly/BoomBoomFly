# Non-governed moving developer index for active sources only. Use only through
# an explicit --manifest plus --allow-moving-refs. Archive and optional sources
# live in their exact-SHA profile manifests.
repositories:
  src/px4_msgs:
    type: git
    url: https://github.com/PX4/px4_msgs.git
    version: v1.16.2
  src/Micro-XRCE-DDS-Agent:
    type: git
    url: https://github.com/eProsima/Micro-XRCE-DDS-Agent.git
    version: v2.4.2
  src/offboard_cpp:
    type: git
    url: https://github.com/BoomBoomFly/offboard_cpp.git
    version: DDS
  src/vision_to_dds:
    type: git
    url: https://github.com/wanone111/vision_to_dds.git
    version: main
  ../communication:
    type: git
    url: https://github.com/wanone111/communication.git
    version: main
