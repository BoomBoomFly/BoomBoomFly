# ROS 2 workspace repositories imported under px4/px4_ws/src.
# Versions intentionally follow the currently checked-out project branches.
repositories:
  external/px4_msgs:
    type: git
    url: https://github.com/PX4/px4_msgs.git
    version: 392e831c1f659429ca83902e66820d7094591410
  boomboom/common:
    type: git
    url: https://github.com/BoomBoomFly/common.git
    version: main
  boomboom/offboard_cpp:
    type: git
    url: https://github.com/BoomBoomFly/offboard_cpp.git
    version: DDS
  boomboom/vision_to_dds:
    type: git
    url: https://github.com/BoomBoomFly/vision_to_dds.git
    version: master
  boomboom/px4_bringup:
    type: git
    url: https://github.com/BoomBoomFly/px4_bringup.git
    version: DDS
