# ROS 2 workspace repositories imported under px4/px4_ws/src.
# Follow the latest commits on these branches when importing or updating.
repositories:
  external/px4_msgs:
    type: git
    url: https://github.com/PX4/px4_msgs.git
    version: release/1.16
  boomboom/common:
    type: git
    url: https://github.com/BoomBoomFly/common.git
    version: main
  boomboom/communication:
    type: git
    url: https://github.com/BoomBoomFly/communication.git
    version: main
  boomboom/embedded_systems:
    type: git
    url: https://github.com/BoomBoomFly/embedded_systems.git
    version: master
  boomboom/offboard_cpp:
    type: git
    url: https://github.com/BoomBoomFly/offboard_cpp.git
    version: DDS
  boomboom/px4_vision_bridge:
    type: git
    url: https://github.com/BoomBoomFly/px4_vision_bridge.git
    version: master
  boomboom/px4_bringup:
    type: git
    url: https://github.com/BoomBoomFly/px4_bringup.git
    version: DDS
  boomboom/perception:
    type: git
    url: https://github.com/BoomBoomFly/perception.git
    version: main
  boomboom/ti:
    type: git
    url: https://github.com/BoomBoomFly/TI.git
    version: master
